{
  "name": "hellocuff-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "powershell -ExecutionPolicy Bypass -File scripts/local.ps1 dev",
    "local:emulators": "powershell -ExecutionPolicy Bypass -File scripts/local.ps1 emulators",
    "test:all": "node scripts/verify.mjs",
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/assemble.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "review": "node scripts/serve-review.mjs",
    "config:validate": "tsx scripts/validate-config.ts",
    "test": "vitest run tests/unit.test.ts tests/auth-session.test.ts tests/photo-processing.test.ts tests/photo-session.test.ts tests/photo-asset.test.ts tests/auth-action.test.ts tests/password-input.test.tsx tests/owner-loading.test.ts tests/owner-model.test.ts",
    "rules:generate": "tsx scripts/generate-rules.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:auth": "tsx --test tests/auth-emulator.test.ts",
    "test:photos": "node --test tests/photo-derivative.test.mjs tests/photo-service.test.mjs tests/photo-auth.test.mjs tests/photo-admission.test.mjs",
    "test:photo-storage": "node --test --test-isolation=none tests/photo-storage.test.mjs",
    "test:browser": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions --project demo-hellocuff --config firebase.local.json",
    "seed": "tsx scripts/seed.ts",
    "test:auth-actions": "tsx --test tests/auth-actions-emulator.test.ts",
    "test:auth-actions:browser": "playwright test --config playwright.auth-actions.config.ts",
    "test:auth-artifact": "node --test tests/auth-only-artifact.test.mjs",
    "auth:build": "node scripts/build-auth-only.mjs",
    "auth:review": "node scripts/serve-auth-review.mjs",
    "uat:local:emulators": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-uat-emulators.ps1",
    "uat:local:build": "node scripts/build-uat-journey-local.mjs",
    "uat:local:serve": "node scripts/serve-uat-journey-local.mjs",
    "test:uat:unit": "node --test tests/uat-service.test.mjs && vitest run tests/uat-adapter.test.ts",
    "test:uat:emulator": "node --test --test-isolation=none tests/uat-emulator.test.mjs",
    "test:uat:browser": "playwright test --config playwright.uat-journey.config.ts",
    "test:uat:hosted-build": "node --test tests/uat-hosted-build.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
